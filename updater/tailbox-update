#!/bin/sh
# Configuration is data, never shell code.
TBU_ROOT=${TBU_ROOT:-}
TBU_CONF=${TBU_CONF:-$TBU_ROOT/etc/tailbox-updater.conf}
config() {
    val=$(sed -n "s/^$1=//p" "$TBU_CONF" 2>/dev/null | tail -n 1)
    [ -n "$val" ] && printf '%s' "$val" || printf '%s' "$2"
}
TBU_REPO_URL=$(config TBU_REPO_URL "${TBU_REPO_URL:-https://github.com/nurockplayer/tailbox-updater/releases}")
TBU_MIN_AGE_H=$(config TBU_MIN_AGE_H "${TBU_MIN_AGE_H:-48}")
TBU_HEALTH_TIMEOUT=$(config TBU_HEALTH_TIMEOUT "${TBU_HEALTH_TIMEOUT:-90}")
TBU_BOOT_WAIT=$(config TBU_BOOT_WAIT "${TBU_BOOT_WAIT:-120}")
TBU_BIN=$(config TBU_BIN "${TBU_BIN:-$TBU_ROOT/usr/sbin/tailscaled}")
TBU_CLI=$(config TBU_CLI "${TBU_CLI:-$TBU_ROOT/usr/sbin/tailscale}")
TBU_ROM_BIN=$(config TBU_ROM_BIN "${TBU_ROM_BIN:-$TBU_ROOT/rom/usr/sbin/tailscaled}")
TBU_UPPER=$(config TBU_UPPER "${TBU_UPPER:-$TBU_ROOT/overlay/upper}")
TBU_INIT=$(config TBU_INIT "${TBU_INIT:-$TBU_ROOT/etc/init.d/tailscale}")
TBU_STATE=$(config TBU_STATE "${TBU_STATE:-$TBU_ROOT/etc/tailbox-updater}")
TBU_WORK=$(config TBU_WORK "${TBU_WORK:-$TBU_ROOT/tmp/tailbox}")
TBU_CRONTAB=$(config TBU_CRONTAB "${TBU_CRONTAB:-$TBU_ROOT/etc/crontabs/root}")
TBU_RCLOCAL=$(config TBU_RCLOCAL "${TBU_RCLOCAL:-$TBU_ROOT/etc/rc.local}")
arch=$(sed -n "s/^DISTRIB_ARCH=['\"]\{0,1\}\([^'\"]*\).*/\1/p" "$TBU_ROOT/etc/openwrt_release" 2>/dev/null)
case $arch in aarch64*) arch=arm64;; arm_*) arch=arm;; mipsel_*) arch=mipsle;; mips_*) arch=mips;; *) arch=unknown;; esac
TBU_ARCH=$(config TBU_ARCH "${TBU_ARCH:-$arch}")
mkdir -p "$TBU_WORK" || exit 1
log() { printf '%s\n' "$*" | tee -a "$TBU_WORK/last.log"; logger -t tailbox-updater "$*" 2>/dev/null || :; }
fetch() {
    case $1 in file://*) cp "${1#file://}" "$2";;
    *) if command -v curl >/dev/null 2>&1; then curl -fsSL "$1" -o "$2"; elif command -v uclient-fetch >/dev/null 2>&1; then uclient-fetch -q -O "$2" "$1"; else wget -q -O "$2" "$1"; fi;; esac
}
field() { sed -n "s/^$1=//p" "$TBU_WORK/release.env"; }
release() {
    fetch "$TBU_REPO_URL/latest/download/release.env" "$TBU_WORK/release.env" || { log 'release fetch failed'; return 1; }
    ver=$(field TBU_VERSION); published=$(field TBU_PUBLISHED); arches=$(field TBU_ARCHES); tested=$(field TBU_TESTED_ARCHES)
    if ! { printf '%s\n' "$ver" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$' &&
    printf '%s\n' "$published" | grep -Eq '^[0-9]+$' &&
    printf '%s\n' "$arches" | grep -Eq '^[a-z0-9 ]+$'; }; then log 'invalid release.env'; return 1; fi
}
version() { "$TBU_BIN" --version 2>/dev/null | head -n 1; }
service_enabled() {
    "$TBU_INIT" enabled || return 1
    [ "$(uci -q get tailscale.settings.enabled 2>/dev/null)" != 0 ]
}
healthy() { "$TBU_CLI" status --json 2>/dev/null | grep -Eq '"BackendState"[[:space:]]*:[[:space:]]*"Running"'; }
wait_health() {
    elapsed=0
    while :; do
        healthy && return 0
        [ "$elapsed" -ge "$TBU_HEALTH_TIMEOUT" ] && return 1
        sleep 5; elapsed=$((elapsed + 5))
    done
}
lock() {
    if ! mkdir "$TBU_WORK/lock" 2>/dev/null; then
        pid=$(cat "$TBU_WORK/lock/pid" 2>/dev/null)
        case $pid in ''|*[!0-9]*) log 'update lock is held'; return 1;; esac
        if kill -0 "$pid" 2>/dev/null; then log 'update lock is held'; return 1; fi
        rm -rf "$TBU_WORK/lock"; mkdir "$TBU_WORK/lock" || return 1
    fi
    echo "$$" > "$TBU_WORK/lock/pid"
    trap 'rm -rf "$TBU_WORK/lock"' EXIT HUP INT TERM
}
restore() {
    "$TBU_INIT" stop || :
    # Stage first so a full overlay keeps whatever binary is there; replace in place only if that fails.
    if ! { cp "$TBU_WORK/prev" "$TBU_BIN.tbu-new" 2>/dev/null && mv -f "$TBU_BIN.tbu-new" "$TBU_BIN"; }; then
        rm -f "$TBU_BIN.tbu-new" "$TBU_BIN"
        if ! cp "$TBU_WORK/prev" "$TBU_BIN" 2>/dev/null; then
            cp "$TBU_ROM_BIN" "$TBU_BIN" || { log 'restore copy failed'; return 1; }
        fi
    fi
    chmod 755 "$TBU_BIN"; sync; "$TBU_INIT" start || :
    if wait_health; then log 'rollback healthy'; return 0; else log 'rollback unhealthy'; return 1; fi
}
newer() {
    awk -v a="$1" -v b="$2" 'BEGIN { split(a,x,"."); split(b,y,"."); for(i=1;i<=3;i++) { if ((x[i]+0) > (y[i]+0)) exit 0; if ((x[i]+0) < (y[i]+0)) exit 1 } exit 2 }'
}
update() {
    lock || return 1
    release || return 1
    case " $arches " in *" $TBU_ARCH "*) :;; *) log "architecture $TBU_ARCH unavailable"; return 0;; esac
    case " $tested " in *" $TBU_ARCH "*) :;; *) log "warning: $TBU_ARCH is untested";; esac
    current=$(version)
    printf '%s\n' "$current" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([-+].+)?$' || { log 'invalid installed version'; return 1; }
    core=${current%%[-+]*}
    newer "$ver" "$core"; comparison=$?
    if [ "$comparison" -eq 1 ] || { [ "$comparison" -eq 2 ] && [ "$force" != yes ]; }; then log 'up to date'; return 0; fi
    if [ "$force" != yes ] && grep -Fxq "$ver" "$TBU_STATE/failed" 2>/dev/null; then log "skipping failed version $ver"; return 0; fi
    now=$(date +%s); due=$((published + TBU_MIN_AGE_H * 3600))
    if [ "$now" -lt "$due" ] && [ "$run_now" != yes ]; then log "waiting, due at $(date -d "@$due" 2>/dev/null || echo "$due")"; return 0; fi
    healthy || { log 'Tailscale is unhealthy; no update'; return 1; }
    available=${TBU_TEST_AVAIL_KB:-$(df -Pk "$TBU_WORK" | awk 'NR==2 {print $4}')}
    [ "$available" -ge 65536 ] || { log 'insufficient work space'; return 1; }
    asset=tailscaled-linux-$TBU_ARCH
    if ! fetch "$TBU_REPO_URL/download/v$ver/SHA256SUMS" "$TBU_WORK/SHA256SUMS" || ! fetch "$TBU_REPO_URL/download/v$ver/$asset" "$TBU_WORK/$asset"; then log 'asset fetch failed'; return 1; fi
    sum=$(awk -v name="$asset" '$2 == name {print $1}' "$TBU_WORK/SHA256SUMS")
    actual=$(sha256sum "$TBU_WORK/$asset" | awk '{print $1}')
    if [ -z "$sum" ] || [ "$sum" != "$actual" ]; then log 'checksum mismatch'; return 1; fi
    chmod 755 "$TBU_WORK/$asset"
    [ "$("$TBU_WORK/$asset" --version | head -n 1)" = "$ver" ] || { log 'asset version mismatch'; return 1; }
    available=${TBU_TEST_BIN_AVAIL_KB:-${TBU_TEST_AVAIL_KB:-$(df -Pk "$(dirname "$TBU_BIN")" | awk 'NR==2 {print $4}')}}
    # Replacing the binary frees only what the overlay holds; a ROM copy restored by boot-check is held there too.
    upper=$TBU_UPPER${TBU_BIN#"$TBU_ROOT"}
    held=yes; old=$(wc -c < "$TBU_BIN")
    if [ -d "$TBU_UPPER" ]; then old=0; held=no; [ -f "$upper" ] && { old=$(wc -c < "$upper"); held=yes; }; fi
    size=$(wc -c < "$TBU_WORK/$asset")
    # A rollback of a ROM-only binary must write the whole binary into the overlay, so it has to fit as well.
    need=$size; [ "$held" = no ] && [ "$(wc -c < "$TBU_BIN")" -gt "$need" ] && need=$(wc -c < "$TBU_BIN")
    [ $((available * 1024 + old)) -ge $((need + 1048576)) ] || { log 'insufficient binary space'; return 1; }
    cp "$TBU_BIN" "$TBU_WORK/prev" || return 1
    printf '%s\n' "$current" > "$TBU_WORK/prev.version"
    # The estimate above uses logical sizes and UBIFS compresses, so stage the new binary beside the old one:
    # if the overlay fills up, the working binary is untouched.
    if cp "$TBU_WORK/$asset" "$TBU_BIN.tbu-new" 2>/dev/null && chmod 755 "$TBU_BIN.tbu-new"; then
        "$TBU_INIT" stop || :
        mv -f "$TBU_BIN.tbu-new" "$TBU_BIN" || { log 'install move failed'; rm -f "$TBU_BIN.tbu-new"; restore; return 1; }
    else
        rm -f "$TBU_BIN.tbu-new"
        # Removing a ROM-only binary frees nothing (it leaves a whiteout), so only replace in place
        # a copy the overlay holds: removing it frees the space its restore needs.
        [ "$held" = yes ] || { log 'insufficient binary space'; return 1; }
        "$TBU_INIT" stop || :
        rm -f "$TBU_BIN"
        if ! cp "$TBU_WORK/$asset" "$TBU_BIN" || ! chmod 755 "$TBU_BIN"; then log 'install copy failed'; restore; return 1; fi
    fi
    sync; "$TBU_INIT" start || :
    if wait_health; then
        mkdir -p "$TBU_STATE"; echo "$ver" > "$TBU_STATE/installed"; rm -f "$TBU_WORK/$asset"; log "installed $ver"; return 0
    fi
    mkdir -p "$TBU_STATE"; echo "$ver" >> "$TBU_STATE/failed"
    log "health check failed for $ver; rolling back"; restore; return 1
}
hooks() {
    if [ "$1" = install ]; then
        self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0") || return 1
        case $self in *'&'*|*\\*|*'
'*) log 'unsafe updater path for hooks'; return 1;; esac
    fi
    mkdir -p "$(dirname "$TBU_CRONTAB")"; touch "$TBU_CRONTAB"
    if [ "$1" = install ]; then
        if ! grep -q '# tailbox-updater$' "$TBU_CRONTAB"; then
            minute=$(awk 'BEGIN { srand(); print int(rand()*60) }')
            echo "$minute 4 * * * $self update # tailbox-updater" >> "$TBU_CRONTAB"; "$TBU_ROOT/etc/init.d/cron" restart
        fi
        if ! grep -q '# tailbox-updater$' "$TBU_RCLOCAL"; then
            sed "/^[[:space:]]*exit 0[[:space:]]*$/i\\
($self boot-check) >/dev/null 2>\\&1 \\&  # tailbox-updater
" "$TBU_RCLOCAL" > "$TBU_WORK/rc.local" && cat "$TBU_WORK/rc.local" > "$TBU_RCLOCAL"
        fi
    else
        if grep -q '# tailbox-updater$' "$TBU_CRONTAB"; then sed '/# tailbox-updater$/d' "$TBU_CRONTAB" > "$TBU_WORK/crontab"; cat "$TBU_WORK/crontab" > "$TBU_CRONTAB"; "$TBU_ROOT/etc/init.d/cron" restart; fi
        sed '/# tailbox-updater$/d' "$TBU_RCLOCAL" > "$TBU_WORK/rc.local" && cat "$TBU_WORK/rc.local" > "$TBU_RCLOCAL"
    fi
}
cmd=${1:---help}; [ "$#" -gt 0 ] && shift
force=no; run_now=no; foreground=no
for arg do case $arg in --force) force=yes;; --now) run_now=yes;; --foreground) foreground=yes;; *) echo "unknown option: $arg" >&2; exit 1;; esac; done
case $cmd in
    update|rollback)
        if [ "$foreground" = no ]; then
            if command -v start-stop-daemon >/dev/null 2>&1; then start-stop-daemon -S -b -x "$0" -- "$cmd" "$@" --foreground || exit 1
            else nohup "$0" "$cmd" "$@" --foreground >> "$TBU_WORK/last.log" 2>&1 & fi
            echo "Started; log: $TBU_WORK/last.log"; exit 0
        fi
        if [ "$cmd" = update ]; then update; else lock && restore; fi;;
    boot-check) sleep "$TBU_BOOT_WAIT"; if ! service_enabled; then log 'tailscale service disabled; boot-check skipped'; exit 0; fi; if ! healthy && ! cmp -s "$TBU_BIN" "$TBU_ROM_BIN"; then lock || exit 1; rm -f "$TBU_WORK/prev"; restore; fi;;
    install-hooks) hooks install;; remove-hooks) hooks remove;;
    status) echo "arch: $TBU_ARCH"; echo "installed: $(version)"; if release; then now=$(date +%s); age=$(((now-published)/3600)); echo "latest: $ver, age: $age hours, due: $([ "$age" -ge "$TBU_MIN_AGE_H" ] && echo yes || echo no)"; fi; echo 'failed:'; cat "$TBU_STATE/failed" 2>/dev/null || :; if grep -q '# tailbox-updater$' "$TBU_CRONTAB" 2>/dev/null && grep -q '# tailbox-updater$' "$TBU_RCLOCAL" 2>/dev/null; then echo 'hooks: installed'; else echo 'hooks: not installed'; fi;;
    --help|help) echo 'Usage: tailbox-update status|update [--now] [--force] [--foreground]|rollback [--foreground]|boot-check|install-hooks|remove-hooks';;
    *) echo "unknown command: $cmd" >&2; exit 1;;
esac
